<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Versione di Revit di destinazione: dotnet build -p:RevitVersion=2024|2025|2026|2027
    2024 -> .NET Framework 4.8 ; 2025/2026 -> .NET 8 (Windows) ; 2027 -> .NET 10 (Windows)
    Il framework deve coincidere con il runtime su cui gira Revit (RevitAPI.runtimeconfig.json nella
    cartella di Revit): usare scripts/install.ps1, che lo rileva automaticamente.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <!-- Framework: derivato dalla versione di Revit, oppure forzato con -p:RevitFramework=net8.0-windows
         (lo script install.ps1 lo legge dal runtime effettivo dell'installazione di Revit). -->
    <RevitFramework Condition="'$(RevitFramework)' == '' And '$(RevitVersion)' == '2024'">net48</RevitFramework>
    <RevitFramework Condition="'$(RevitFramework)' == '' And ('$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026')">net8.0-windows</RevitFramework>
    <RevitFramework Condition="'$(RevitFramework)' == ''">net10.0-windows</RevitFramework>
    <TargetFramework>$(RevitFramework)</TargetFramework>
    <!-- L'interfaccia WPF è costruita da codice (nessun XAML): bastano i riferimenti alle librerie,
         così il progetto si compila anche su Linux/macOS senza l'SDK WindowsDesktop. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>SayRevit.Addin</RootNamespace>
    <AssemblyName>SayRevit.Addin</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>../../artifacts/$(RevitVersion)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Description>Add-in Revit: da descrizione testuale a tubazioni e canali.</Description>
  </PropertyGroup>
  <!-- Riferimenti all'API di Revit: dalla cartella di installazione se indicata con
       -p:RevitApiDir="C:\Program Files\Autodesk\Revit 2027" (sempre coerente con il runtime di quel Revit),
       altrimenti dai pacchetti NuGet Nice3point (utile per compilare senza Revit installato). -->
  <ItemGroup Condition="'$(RevitApiDir)' != ''">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiDir)/RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiDir)/RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(RevitApiDir)' == ''">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SayRevit.Core/SayRevit.Core.csproj" />
    <ProjectReference Include="../SayRevit.Claude/SayRevit.Claude.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="SayRevit.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
